{
  "schema": "traze-repository-selection-v1",
  "qualification": "Traze source, developer documentation, supplied frontend assets and offline test fixtures. Runtime state, installed dependencies and generated reports are excluded.",
  "include": [
    ".gitignore",
    ".gitattributes",
    ".github/workflows/checks.yml",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "repository-files.json",
    "hemi_lookup_cli.py",
    "hemi_lookup_web.py",
    "hemi_catalogue.py",
    "hemi_lookup/**/*.py",
    "traze_evidence/*.py",
    "frontend/package.json",
    "frontend/package-lock.json",
    "frontend/tsconfig*.json",
    "frontend/vite.config.ts",
    "frontend/index.html",
    "frontend/.gitignore",
    "frontend/THIRD_PARTY_NOTICES.md",
    "frontend/src/**/*",
    "frontend/public/**/*",
    "frontend/licenses/*",
    "web/**/*",
    "catalogue_demo/*",
    "tests/*.py",
    "tests/fixtures/**/*",
    "examples/snapshot-first-height/**/*",
    "scripts/*.py",
    "docs/**/*",
    "deploy/*",
    "third_party/*",
    "demo_results/README.md",
    "demo_results/mainnet_5243117.json",
    "demo_results/mainnet_5243125.json",
    "demo_results/scoped_no_match.json",
    "demo_results/milestone2_automatic_20261004T170034660491Z.json",
    "demo_results/milestone3_march_later_hash_20261004T174823173306Z.json",
    "demo_results/main_catalogue_5243119.json",
    "demo_results/phase1_5243118.json",
    "scripts/*.mjs",
    "tests/*.mjs"
  ],
  "exclude": [
    "**/__pycache__/**",
    "tests/report_milestone1.py",
    "tests/test_milestone2.py",
    "tests/test_source_feasibility.py"
  ],
  "required": [
    "README.md",
    "LICENSE",
    ".gitignore",
    ".gitattributes",
    ".github/workflows/checks.yml",
    "hemi_catalogue.py",
    "hemi_lookup/web.py",
    "hemi_lookup/public.py",
    "hemi_lookup/backup.py",
    "traze_evidence/__init__.py",
    "traze_evidence/__main__.py",
    "traze_evidence/snapshot.py",
    "hemi_lookup/snapshot_packet.py",
    "docs/SNAPSHOT_ASSURANCE.md",
    "examples/snapshot-first-height/README.md",
    "examples/snapshot-first-height/packet/manifest.json",
    "scripts/check_startup.py",
    "deploy/requirements.txt",
    "deploy/Caddyfile",
    "docs/HOSTING.md",
    "tests/fixtures/bitcoin_blocks/manifest.json",
    "frontend/package-lock.json",
    "web/index.html",
    "third_party/heminetwork-LICENSE.txt",
    "scripts/verify-evidence.mjs",
    "scripts/verify-input-binding.mjs",
    "tests/verifier-cli.test.mjs",
    "frontend/public/THIRD_PARTY_LICENSES.txt",
    "web/THIRD_PARTY_LICENSES.txt"
  ]
}
